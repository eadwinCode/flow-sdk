{
  "name": "flow-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/ts"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run --workspaces --if-present test",
    "build": "bun run --workspaces --if-present build",
    "examples:ts": "bun run --filter @clevix/flow-examples typecheck",
    "examples:go": "cd examples/go && test -z \"$(gofmt -l .)\" && go vet ./... && go build -o /dev/null ./...",
    "examples:check": "bun run examples:ts && bun run examples:go",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitepress": "1.6.4"
  }
}
